FROM --platform=linux/arm64 almalinux:8

RUN dnf install -y epel-release 'dnf-command(config-manager)' && \
    (dnf config-manager --set-enabled powertools || dnf config-manager --set-enabled crb || true) && \
    dnf install -y \
        gcc \
        gcc-c++ \
        cmake \
        make \
        protobuf-devel \
        protobuf-compiler \
        libxml2-devel \
        krb5-devel \
        libuuid-devel \
        libgsasl-devel \
        boost-devel \
    && dnf clean all

WORKDIR /workspace
COPY . /workspace

RUN mkdir -p build && cd build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
    && make -j$(nproc) libhdfs3-shared

CMD ["cp", "-f", "build/src/libhdfs3.so", "/output/"]
