+static void
+expand_des_key (const unsigned char *in7, unsigned char *out8)
+{
+  uint64_t in56 = 0;
+  int i, j;
+  for (i = 0; i < 7; i++)
+    in56 = (in56 << 8) | (uint64_t) in7[i];
+
+  for (i = 0; i < 8; i++)
+    {
+      unsigned char b = (in56 >> (56 - 7 * (i + 1))) & 0x7F;
+      int c = 0;
+      b <<= 1;
+      for (j = 1; j < 8; j++)
+        {
+          if (b & (1 << j))
+            c++;
+        }
+      if ((c & 1) == 0)
+        b |= 1;
+      out8[i] = b;
+    }
+}
